# ── Servidor ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# URL pública del servidor (se usa en los snippets de integración, archivos subidos y correos)
PUBLIC_URL=http://localhost:4000
# Orígenes permitidos para CORS (separados por coma). En producción normalmente es la misma URL.
CORS_ORIGINS=http://localhost:5180

# ── Seguridad ───────────────────────────────────────────────────────────────
# Obligatorio en producción. Genere uno largo y aleatorio, p. ej.: openssl rand -hex 32
JWT_SECRET=cambie-este-secreto
JWT_EXPIRES_IN=7d
# Permitir registro público de usuarios (/register). Recomendado: false (los crea el administrador)
ALLOW_PUBLIC_REGISTRATION=false

# ── Usuario administrador inicial (solo se crea si la base de datos está vacía) ─
ADMIN_EMAIL=admin@sigmocad.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador
# Recuperación: con true, en cada arranque se restablece la contraseña de ADMIN_EMAIL a ADMIN_PASSWORD. Volver a false después.
ADMIN_FORCE_PASSWORD=false
# Empresa/institución de ejemplo creada junto al administrador (vacío = ninguna)
SEED_COMPANY_NAME=Institución de Ejemplo

# ── Base de datos y archivos ───────────────────────────────────────────────
DB_PATH=data/sigmocad.db
# Modo de journal de SQLite: WAL (disco local, por defecto) o DELETE (discos de red, p. ej. Azure App Service /home)
SQLITE_JOURNAL_MODE=WAL
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
# Carpeta con el build del cliente (npm run build) para servirlo desde Express
CLIENT_DIST=../client/dist

# ── Correo (envío de noticias a medios) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIGMOCAD <info@ejemplo.com>"

# ── Monitoreo RSS ──────────────────────────────────────────────────────────
# Minutos entre sondeos de las fuentes RSS configuradas (0 = desactivado)
RSS_POLL_MINUTES=15
# Secreto opcional para el webhook externo POST /api/rss-webhook (header x-webhook-secret)
RSS_WEBHOOK_SECRET=

# ── Métricas ───────────────────────────────────────────────────────────────
# Geolocalización de IPs vía ip-api.com (gratuito, sin clave)
GEO_LOOKUP=true
